{
    "model_name": "Logistic Regression",
    "model_file": "models/final_logistic_regression_pipeline.joblib",
    "target": "Mental_Health_Risk",
    "target_classes": [
        "High",
        "Low",
        "Medium"
    ],
    "input_features": [
